{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows",
            "displayName": "Windows Release",
            "description": "Build for Windows with Visual Studio",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/cmake-build-release-win64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android",
            "displayName": "Android ARM64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-relwithdebinfo-android-arm64",
            "toolchainFile": "$env{NDK_ROOT}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "Release",
            "targets": "RenderEngineLauncher"
        },
        {
            "name": "android",
            "configurePreset": "android",
            "configuration": "RelWithDebInfo",
            "targets": "RenderEngineLauncher"
        }
    ]    
}